generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum Role {
  SUPER_ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  ORDERING
  WAITING_FOOD
  DINING
  PAYMENT_REQUESTED
  CHECKOUT
  CLEANING
  DISABLED
}

enum TableSessionStatus {
  OPEN
  PAYMENT_REQUESTED
  PAID
  CLOSED
  CANCELLED
}

enum OrderSource {
  CUSTOMER
  STAFF
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderItemStatus {
  SUBMITTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum CustomerRequestType {
  CALL_STAFF
  WATER
  UTENSILS
  ITEM_SUPPORT
  OTHER
}

enum CustomerRequestStatus {
  NEW
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  E_WALLET
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  VOIDED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

// =========================================================================
// ORGANIZATION
// =========================================================================

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]
}

model Branch {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  address      String?
  timezone     String     @default("Asia/Ho_Chi_Minh")

  // Simple settings (V1: one branch, but schema supports many)
  taxRatePercent            Decimal @default(0) @db.Decimal(5, 2)
  autoAvailableAfterPayment Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas           Area[]
  tables          Table[]
  users           User[]
  menuCategories  MenuCategory[]
  kitchenStations KitchenStation[]
}

model Area {
  id        String  @id @default(cuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  tables Table[]

  @@index([branchId])
}

// =========================================================================
// USERS / AUTH
// =========================================================================

model User {
  id           String   @id @default(cuid())
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions         Session[]
  ordersCreated    Order[]           @relation("OrderCreatedBy")
  openedSessions   TableSession[]    @relation("SessionOpenedBy")
  payments         Payment[]         @relation("PaymentCashier")
  acceptedRequests CustomerRequest[] @relation("RequestAcceptedBy")
  auditLogs        AuditLog[]        @relation("AuditActor")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

// =========================================================================
// TABLES / SESSIONS
// =========================================================================

model Table {
  id       String      @id @default(cuid())
  branchId String
  branch   Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  areaId   String
  area     Area        @relation(fields: [areaId], references: [id])
  code     String
  name     String
  seats    Int         @default(2)
  qrToken  String      @unique
  status   TableStatus @default(AVAILABLE)
  active   Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions TableSession[]

  @@unique([branchId, code])
  @@index([areaId])
}

model TableSession {
  id         String             @id @default(cuid())
  tableId    String
  table      Table              @relation(fields: [tableId], references: [id])
  openedAt   DateTime           @default(now())
  closedAt   DateTime?
  guestCount Int                @default(1)
  openedById String?
  openedBy   User?              @relation("SessionOpenedBy", fields: [openedById], references: [id])
  status     TableSessionStatus @default(OPEN)

  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  discountReason String?
  discountById   String?
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)

  orders           Order[]
  customerRequests CustomerRequest[]
  payments         Payment[]

  @@index([tableId])
  @@index([status])
}

// =========================================================================
// MENU
// =========================================================================

model MenuCategory {
  id          String  @id @default(cuid())
  branchId    String
  branch      Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String
  description String?
  image       String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  items MenuItem[]

  @@index([branchId])
}

model KitchenStation {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  code     String // MAIN_KITCHEN | BAR | DESSERT | ...
  name     String

  menuItems  MenuItem[]
  orderItems OrderItem[]

  @@unique([branchId, code])
}

model MenuItem {
  id               String          @id @default(cuid())
  categoryId       String
  category         MenuCategory    @relation(fields: [categoryId], references: [id])
  sku              String
  name             String
  description      String?
  image            String?
  basePrice        Decimal         @db.Decimal(12, 2)
  salePrice        Decimal?        @db.Decimal(12, 2)
  active           Boolean         @default(true)
  soldOut          Boolean         @default(false)
  kitchenStationId String?
  kitchenStation   KitchenStation? @relation(fields: [kitchenStationId], references: [id])
  preparationTime  Int? // minutes
  sortOrder        Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants       MenuVariant[]
  modifierGroups MenuItemModifierGroup[]
  orderItems     OrderItem[]

  @@unique([categoryId, sku])
  @@index([categoryId])
}

model MenuVariant {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String // e.g. Small / Medium / Large
  priceDelta Decimal  @default(0) @db.Decimal(12, 2)
  isDefault  Boolean  @default(false)
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)

  @@index([menuItemId])
}

model ModifierGroup {
  id        String  @id @default(cuid())
  name      String // e.g. Topping, Muc cay, Da, Duong
  required  Boolean @default(false)
  minSelect Int     @default(0)
  maxSelect Int     @default(1)

  options   ModifierOption[]
  menuItems MenuItemModifierGroup[]
}

model ModifierOption {
  id         String        @id @default(cuid())
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  priceDelta Decimal       @default(0) @db.Decimal(12, 2)
  active     Boolean       @default(true)
  sortOrder  Int           @default(0)

  @@index([groupId])
}

// Join table: which modifier groups apply to which menu item
model MenuItemModifierGroup {
  menuItemId String
  menuItem   MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sortOrder  Int           @default(0)

  @@id([menuItemId, groupId])
}

// =========================================================================
// ORDERS
// =========================================================================

model Order {
  id              String       @id @default(cuid())
  orderNumber     Int          @default(autoincrement())
  tableSessionId  String
  tableSession    TableSession @relation(fields: [tableSessionId], references: [id])
  source          OrderSource
  createdByUserId String?
  createdByUser   User?        @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])
  status          OrderStatus  @default(SUBMITTED)
  note            String?
  createdAt       DateTime     @default(now())
  submittedAt     DateTime?
  preparingAt     DateTime?
  readyAt         DateTime?
  servedAt        DateTime?
  cancelledAt     DateTime?

  items OrderItem[]

  @@index([tableSessionId])
  @@index([status])
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId          String
  menuItem            MenuItem        @relation(fields: [menuItemId], references: [id])
  itemNameSnapshot    String
  variantNameSnapshot String?
  unitPriceSnapshot   Decimal         @db.Decimal(12, 2)
  quantity            Int
  note                String?
  status              OrderItemStatus @default(SUBMITTED)
  kitchenStationId    String?
  kitchenStation      KitchenStation? @relation(fields: [kitchenStationId], references: [id])

  modifiers OrderItemModifier[]

  @@index([orderId])
}

model OrderItemModifier {
  id                 String    @id @default(cuid())
  orderItemId        String
  orderItem          OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  nameSnapshot       String
  priceDeltaSnapshot Decimal   @default(0) @db.Decimal(12, 2)

  @@index([orderItemId])
}

// =========================================================================
// CUSTOMER REQUESTS
// =========================================================================

model CustomerRequest {
  id             String                @id @default(cuid())
  tableSessionId String
  tableSession   TableSession          @relation(fields: [tableSessionId], references: [id])
  tableId        String
  type           CustomerRequestType
  note           String?
  status         CustomerRequestStatus @default(NEW)
  createdAt      DateTime              @default(now())
  acceptedAt     DateTime?
  completedAt    DateTime?
  acceptedById   String?
  acceptedBy     User?                 @relation("RequestAcceptedBy", fields: [acceptedById], references: [id])

  @@index([tableSessionId])
  @@index([status])
}

// =========================================================================
// PAYMENTS
// =========================================================================

model Payment {
  id             String        @id @default(cuid())
  tableSessionId String
  tableSession   TableSession  @relation(fields: [tableSessionId], references: [id])
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  reference      String?
  paidAt         DateTime?
  cashierId      String?
  cashier        User?         @relation("PaymentCashier", fields: [cashierId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([tableSessionId])
}

// =========================================================================
// AUDIT
// =========================================================================

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  actorLabel  String
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
